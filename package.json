{
  "name": "plain-consent",
  "version": "2.2.0",
  "description": "Plain Consent: a free, dependency-free cookie consent banner, built on vanilla-cookieconsent. Opt-in, Google Consent Mode v2, Subresource Integrity, strict-CSP friendly.",
  "keywords": [
    "cookie-consent",
    "cookie-banner",
    "consent-banner",
    "gdpr",
    "eprivacy",
    "google-consent-mode",
    "consent-mode-v2",
    "global-privacy-control",
    "subresource-integrity",
    "csp",
    "opt-in",
    "czech"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Socionet <info@socionet.cz> (https://socionet.cz)",
  "homepage": "https://socionet.cz/nastroje/cookie-lista/",
  "bugs": {
    "url": "https://github.com/petrhromadka/plain-consent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petrhromadka/plain-consent.git"
  },
  "files": [
    "releases/",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test 'src/*.test.ts'",
    "check": "node node_modules/typescript/bin/tsc --noEmit",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "typescript6": "npm:typescript@6.0.3",
    "vanilla-cookieconsent": "3.1.0"
  }
}
